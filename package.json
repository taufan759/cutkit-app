{
  "name": "cutkit-app",
  "private": true,
  "version": "0.1.0",
  "description": "CutKit: editor video ringan untuk Shorts 9:16, offline di komputermu",
  "license": "MIT",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "test": "node --test tests/ && cargo test -p cutkit-core",
    "test:js": "node --test tests/",
    "icon": "tauri icon src-tauri/icons/icon.svg -o src-tauri/icons",
    "test:ai": "cargo test -p cutkit-core --test ai_real -- --ignored --nocapture",
    "build:cli": "cargo build --release -p cutkit-cli",
    "mcp": "node mcp/server.js"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
