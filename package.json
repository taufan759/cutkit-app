{
  "name": "cutkit-app",
  "private": true,
  "version": "0.3.0",
  "description": "CutKit: editor video ringan untuk Shorts dan YouTube, offline di komputermu",
  "license": "MIT",
  "scripts": {
    "dev": "cargo build --release -p cutkit-cli && tauri dev",
    "build": "powershell -ExecutionPolicy Bypass -File installer/build.ps1",
    "test": "node --test \"tests/*.test.js\" && cargo test -p cutkit-core",
    "test:js": "node --test \"tests/*.test.js\"",
    "icon": "tauri icon src-tauri/icons/icon.svg -o src-tauri/icons",
    "test:ai": "cargo test -p cutkit-core --test ai_real -- --ignored --nocapture",
    "build:cli": "cargo build --release -p cutkit-cli",
    "mcp": "node mcp/server.js",
    "build:nsis": "cargo build --release -p cutkit-cli && tauri build",
    "test:setup": "cargo test -p cutkit-core --test setup_real -- --ignored --nocapture",
    "build:linux": "cargo build --release -p cutkit-cli && tauri build --bundles deb,appimage",
    "build:mac": "sh scripts/build-mac.sh"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
