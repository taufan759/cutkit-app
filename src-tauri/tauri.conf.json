{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CutKit",
  "version": "0.1.0",
  "identifier": "io.github.taufan759.cutkit",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CutKit",
        "width": 1400,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 640,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' data: blob: asset: http://asset.localhost; style-src 'self'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Video",
    "shortDescription": "Editor video ringan untuk Shorts dan YouTube, bisa dipakai lewat Claude (MCP)",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../mcp/server.js": "mcp/server.js",
      "../target/release/cutkit-cli.exe": "mcp/cutkit-cli.exe",
      "../ui/core/*.js": "ui/core/",
      "../ui/templates/*.json": "ui/templates/"
    }
  }
}
